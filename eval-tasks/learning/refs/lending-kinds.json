    "file": "lending/lending.go",
    "after": "Item",
    "content": "// kindOf is the kind named name, or nil.\nfunc kindOf(name string) Kind {\n\tswitch name {\n\tcase \"book\":\n\t\treturn Book{}\n\tcase \"dvd\":\n\t\treturn DVD{}\n\tcase \"atlas\":\n\t\treturn Atlas{}\n\t}\n\treturn nil\n}"
   }
  },
  {
   "tool": "replace_statements",
   "args": {
    "file": "lending/lending.go",
    "function": "Import",
    "content": "var items []Item\nvar lines []int\nvar names []string\nfor i, line := range strings.Split(text, \"\\n\") {\n\tline = strings.TrimSpace(line)\n\tif line == \"\" || strings.HasPrefix(line, \"#\") {\n\t\tcontinue\n\t}\n\tf := strings.Split(line, \"|\")\n\tif len(f) != 4 {\n\t\treturn fmt.Errorf(\"line %d: want 4 fields, got %d\", i+1, len(f))\n\t}\n\tn, err := strconv.Atoi(strings.TrimSpace(f[3]))\n\tif err != nil {\n\t\treturn fmt.Errorf(\"line %d: copies: %v\", i+1, err)\n\t}\n\tname := strings.TrimSpace(f[2])\n\titems = append(items, Item{ID: strings.TrimSpace(f[0]), Title: strings.TrimSpace(f[1]), Kind: kindOf(name), Copies: n})\n\tlines = append(lines, i+1)\n\tnames = append(names, name)\n}\nseen := map[string]bool{}\nfor k, it := range items {\n\tif it.ID == \"\" {\n\t\treturn fmt.Errorf(\"line %d: no id\", lines[k])\n\t}\n\tif LoanDays(it) == 0 {\n\t\treturn fmt.Errorf(\"line %d: unknown kind %q\", lines[k], names[k])\n\t}\n\tif it.Copies <= 0 {\n\t\treturn fmt.Errorf(\"line %d: no copies\", lines[k])\n\t}\n\tif _, there := c.Items[it.ID]; there || seen[it.ID] {\n\t\treturn fmt.Errorf(\"line %d: %s is already there\", lines[k], it.ID)\n\t}\n\tseen[it.ID] = true\n}\nif c.Items == nil {\n\tc.Items = map[string]Item{}\n}\nfor _, it := range items {\n\tc.Items[it.ID] = it\n}\nreturn nil"
   }
  },
